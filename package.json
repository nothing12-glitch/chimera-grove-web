{
  "name": "chimera-grove-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chimera Grove — web version. 2D pixel art alchemy farming sim.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:art": "node scripts/check-art.ts",
    "check:pack": "node --import ./scripts/ts-run.mjs scripts/check-art-pack.ts",
    "check:world": "node --import ./scripts/ts-run.mjs scripts/check-world.ts",
    "check:combat": "node --import ./scripts/ts-run.mjs scripts/check-combat.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.0",
    "@rollup/rollup-linux-x64-musl": "4.68.0"
  }
}
